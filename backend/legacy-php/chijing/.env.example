# 复制为 .env 后填写；不要把 .env 上传到代码仓库。
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_KEY=replace-with-a-random-32-byte-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_database_name
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password

# 后续接入模型服务时使用内网地址，不要暴露模型端口到公网。
AI_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_MAX_MB=10

# 仅限将已验证的旧固件迁移到设备令牌前的短暂过渡期。
# 生产环境必须为 false；旧固件须至少发送 X-Device（设备 UID）。
ALLOW_LEGACY_UNAUTHENTICATED_UPLOAD=false
