# 将本文件复制到服务器：/www/wwwroot/chijing_runtime/ai/bailian.env
# 不要把真实 API Key 放进网站目录、Git 仓库或浏览器代码。

BAILIAN_API_KEY=在这里填入百炼 API Key
# AI 牙医使用的 OpenAI 兼容地址。请填写当前百炼工作空间自己的地址。
BAILIAN_OPENAI_BASE_URL=https://ws-sk9a2fzftxh5to2c.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_REALTIME_WS_URL=wss://ws-sk9a2fzftxh5to2c.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# “千问实时语音大模型（标准版）”通常对应 plus；以百炼控制台显示的实际模型 API 名为准。
BAILIAN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
# Qwen-Audio 的内置输入语音转写；用于生成设备端“用户说了什么”的文字记录。
BAILIAN_INPUT_TRANSCRIPTION_MODEL=fun-asr
AI_GATEWAY_SECRET=用openssl_rand_生成的64位十六进制随机字符串
AI_GATEWAY_ALLOWED_ORIGIN=https://wwwxsh.cn
AI_GATEWAY_PUBLIC_PATH=/ai-gateway/
AI_GATEWAY_LISTEN_HOST=127.0.0.1
AI_GATEWAY_LISTEN_PORT=8765
# ESP32-P4 常驻语音 WSS：无业务消息多久后正常断开，以及单连接最长寿命。
AI_GATEWAY_DEVICE_IDLE_SECONDS=120
AI_GATEWAY_DEVICE_MAX_CONNECTION_SECONDS=1800
# 网关读取网页端/设备端独立会话记忆的内部接口。
AI_GATEWAY_CONTEXT_URL=https://wwwxsh.cn/api/assistant_context.php
# AI Gateway 将最终用户转写和助手转写写回设备对话记录的内部接口。
AI_GATEWAY_MESSAGE_CALLBACK_URL=https://wwwxsh.cn/api/assistant_device.php?action=gateway_save_message
AI_GATEWAY_TOOL_CALLBACK_URL=https://wwwxsh.cn/api/assistant_tools.php
# 诊断 ESP32-P4 上行音频。1=保存解码后的 WAV，0=关闭。
AI_GATEWAY_CAPTURE_DEVICE_AUDIO=1
AI_GATEWAY_CAPTURE_DIR=/www/wwwroot/chijing_storage/ai_audio_debug

# AI 牙医签名图片对外访问所使用的正式域名。
AI_DENTIST_PUBLIC_ORIGIN=https://wwwxsh.cn
# 可进入 AI 牙医管理后台的账户邮箱，多个邮箱用英文逗号分隔。
AI_DENTIST_ADMIN_EMAILS=admin@example.com
